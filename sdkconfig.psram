# Overlay for the PSRAM variant (tools/build.sh psram): dual core + PSRAM (boards with an ESP32-WROVER / ESP32-D0WDR2 / PSRAM module).
# Applied after sdkconfig.defaults. The standard image cannot carry PSRAM support: it would not fit the OTA slot (1.44 MB) and costs 16 KB of IRAM.
# CONFIG_ESP32_IRAM_AS_8BIT_ACCESSIBLE_MEMORY is not set
# CONFIG_FREERTOS_UNICORE is not set
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_MQTT_TASK_CORE_SELECTION_ENABLED=y
CONFIG_MQTT_USE_CORE_0=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.psram.csv"
