CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_FREERTOS_HZ=1000
# --- dual core: the system (Wi-Fi, TCP/IP, MQTT I/O, web, SSH, OTA, log writer) on core 0, the tank controller (sonar, control loop) on core 1 ---
CONFIG_ESP_WIFI_TASK_CORE_ID=0
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_MQTT_TASK_CORE_SELECTION_ENABLED=y
CONFIG_MQTT_USE_CORE_0=y
CONFIG_ESP_ENABLE_WOLFSSH=y
CONFIG_LOG_COLORS=n
# --- web ---
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=240
# --- OTA with automatic rollback of an image that does not come up healthy ---
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_MBEDTLS_HARDWARE_SHA=n
# --- not needed ---
# CONFIG_LWIP_STATS is not set
