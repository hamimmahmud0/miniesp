CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Leave as much IRAM as possible free: AOT code is loaded into executable heap (IRAM)
# CONFIG_ESP32_WIFI_IRAM_OPT is not set
# CONFIG_ESP32_WIFI_RX_IRAM_OPT is not set
# CONFIG_LWIP_IRAM_OPTIMIZATION is not set
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_SPI_FLASH_PLACE_FUNCTIONS_IN_FLASH=n
CONFIG_WAMR_ENABLE_AOT=y
CONFIG_WAMR_ENABLE_INTERP=n
CONFIG_WAMR_ENABLE_LIB_PTHREAD=n
CONFIG_WAMR_ENABLE_LIBC_BUILTIN=y
CONFIG_WAMR_ENABLE_LIBC_WASI=y
CONFIG_ESP_ENABLE_WOLFSSH=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_WAMR_ENABLE_REF_TYPES=y
CONFIG_ESP32_IRAM_AS_8BIT_ACCESSIBLE_MEMORY=y
CONFIG_FREERTOS_UNICORE=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=240
# --- RAM diet: DRAM is the scarce resource (each program needs a reserved 64 KB linear memory) ---
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_TX_BA_WIN=6
CONFIG_LWIP_STATS=y
# --- OTA: two app slots + automatic rollback of an image that does not come up healthy ---
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_MBEDTLS_HARDWARE_SHA=n
# --- TLS (sys_http_get, MQTT over TLS): allocate record buffers only while needed, free handshake data (RAM is scarce) ---
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
# --- CA bundle: the common roots only (Let's Encrypt, DigiCert, GlobalSign, Google, Amazon, Sectigo, ...): saves ~100 KB of flash ---
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
